<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="org.arclight.settings.system">
    <description>Change system settings</description>
    <description xml:lang="zh_CN">更改系统设置</description>
    <message>Authentication is required to change system settings</message>
    <message xml:lang="zh_CN">更改系统设置需要管理员认证</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/arclight-system-policy</annotate>
  </action>
</policyconfig>
